# Azure AI Foundry
# From: Foundry project overview page → "Project endpoint"
PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Foundry model deployment name (Models + endpoints)
MODEL_DEPLOYMENT_NAME=gpt-4o

# Fabric Data Agent endpoints (from published Fabric agents)
FABRIC_SALES_AGENT_ENDPOINT=https://<fabric-workspace>.fabric.microsoft.com/.../sales-agent
FABRIC_INVENTORY_AGENT_ENDPOINT=https://<fabric-workspace>.fabric.microsoft.com/.../inventory-agent
FABRIC_LABOR_AGENT_ENDPOINT=https://<fabric-workspace>.fabric.microsoft.com/.../labor-agent

# Fabric auth (Service Principal — Entra ID app registration)
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_SECRET=your-client-secret-here
